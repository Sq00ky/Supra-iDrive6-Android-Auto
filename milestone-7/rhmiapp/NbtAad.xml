          <checkbox action="27" id="68" model="42" text="MENU key opens iDrive" textModel="43"/>
          <checkbox action="28" id="69" model="44" text="Show driving mode changes" textModel="45"/>
          <checkbox action="29" id="72" model="46" text="Turn arrows in cluster/HUD" textModel="47"/>
          <checkbox action="30" id="73" model="48" text="Show iDrive warnings" textModel="49"/>
