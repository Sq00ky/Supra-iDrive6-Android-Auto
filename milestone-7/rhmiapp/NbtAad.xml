          <checkbox action="87" id="90" model="88" text="Use Phone GPS" textModel="89"/>
          <checkbox action="91" id="94" model="92" text="Use WiFi Direct Network" textModel="93"/>
          <checkbox action="120" id="123" model="121" text="Use Native Audio instead of Bluetooth" textModel="122"/>
          <checkbox action="124" id="127" model="125" text="Media Controls for LCI Steering Wheels" textModel="126"/>
