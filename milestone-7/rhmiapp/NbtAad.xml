      </hmiState>
      <!-- Settings (rhmiapp-39): the six checkboxes, reached from the Settings row (hmiAction 80) in hmiState 10.
           Wired like the About page (state 12): parentId 10, so BACK returns to the menu. Checkboxes in a child state
           are the normal pattern - BMW's own SecurityMenu.xml: hmiState 856 parentId 854 ("Werkstattmodus") holds four
           <checkbox> rows, opened from a button in 854. Kept LAST in this list: the framework numbers plugin states
           50000 + XML order, so appending does not move state 13 (50002) or state 10 (50000). -->
      <hmiState id="14" parentId="10" text="Settings" textModel="82">
        <properties>
          <property id="24" value="3"/>
        </properties>
        <components>
          <checkbox action="24" id="64" model="34" text="Start automatically" textModel="35"/>
